@@ -496,6 +496,32 @@
     -fx-padding: 0.05em 0.55em 0.1em 0.55em;
 }
 
+/* Neo Forge 3D: die Draft-Bewertung in einer Zeile von Deck oder Bank, im
+   Look der Pastille auf der Karte (.card-draft-rank): dunkel, gruen ab 66,
+   gedaempft unter 33. Feste Breite, damit die Namen untereinander bleiben. */
+.deck-row-rank {
+    -fx-font-size: 0.8em;
+    -fx-font-weight: bold;
+    -fx-text-fill: -neo-text;
+    -fx-background-color: rgba(8,11,16,0.95);
+    -fx-background-radius: 4;
+    -fx-border-color: rgba(255,255,255,0.28);
+    -fx-border-radius: 4;
+    -fx-border-width: 1;
+    -fx-padding: 0 0.3em 0 0.3em;
+    -fx-min-width: 2.1em;
+    -fx-alignment: center;
+}
+.deck-row-rank:rank-good {
+    -fx-text-fill: #0B0E13;
+    -fx-background-color: -neo-valid;
+    -fx-border-color: rgba(0,0,0,0.35);
+}
+.deck-row-rank:rank-poor {
+    -fx-text-fill: -neo-text-dim;
+    -fx-border-color: rgba(255,255,255,0.12);
+}
+
 /* Las copias de mas de una suelta de la tienda: "x5" abajo a la derecha (Discord, 15-10-2026). */
 .shop-count {
     -fx-font-size: 0.95em;
