diff --git a/forge-gui-neo/src/main/java/forge/neo/draft/DraftRating.java b/forge-gui-neo/src/main/java/forge/neo/draft/DraftRating.java
new file mode 100644
index 0000000..94b8bdb
--- /dev/null
+++ b/forge-gui-neo/src/main/java/forge/neo/draft/DraftRating.java
@@ -0,0 +1,65 @@
+package forge.neo.draft;
+
+import forge.gamemodes.limited.CardRanker;
+import forge.item.PaperCard;
+import forge.neo.NeoSettings;
+
+/**
+ * Die Bewertung einer Karte fuer Draft und Deckbau, 0-99.
+ *
+ * <p>Neo Forge 3D: Eine Stelle fuer die Zahl, damit der Draft-Bildschirm
+ * ({@code DraftScreen}) und der Deck-Editor ({@code DeckBuilderScreen}) fuer
+ * dieselbe Karte immer dieselbe Zahl zeigen. Sie kommt aus Forges
+ * {@link CardRanker#getRawScore} (die Ranglisten in {@code res/draft/rankings},
+ * bei Cubes die eigene Rangliste); eine Grundlandkarte ist dort absichtlich
+ * "unpickable" (-100) und wird auf 0 gesetzt.
+ */
+public final class DraftRating {
+
+    /** Ab hier gruen: eine Karte, die man gern nimmt. */
+    public static final int GOOD = 66;
+    /** Darunter gedaempft: eine Karte, die meist auf der Bank bleibt. */
+    public static final int POOR = 33;
+
+    private DraftRating() {
+    }
+
+    /**
+     * Was {@link CardRanker#getRawScore} fuer "keine Daten" liefert (dort
+     * {@code SCORE_UNPICKABLE}, privat): Grundlaender UND jede Karte, die in
+     * keiner Rangliste steht — etwa ein Set, fuer das Forge noch keine
+     * {@code .rnk} mitbringt (Star Trek, TRK).
+     */
+    private static final double NO_DATA = -100.0;
+
+    /**
+     * Die Zahl fuer diese Karte, 0-99, oder {@code null}, wenn Forge fuer sie
+     * keine Bewertung hat. Frueher wurde daraus eine 0 — bei einem Set ohne
+     * Rangliste stand dann auf JEDER Karte 0, als waeren alle gleich schlecht.
+     * Grundlaender bleiben bei 0 (absichtlich "unpickable").
+     */
+    public static Integer of(final PaperCard card) {
+        final double raw = CardRanker.getRawScore(card);
+        if (raw <= NO_DATA && !DraftDeckContext.isBasic(card)) {
+            return null;
+        }
+        return (int) Math.round(Math.max(0, Math.min(99, raw)));
+    }
+
+    /**
+     * Die Zahl, wenn sie in den Einstellungen eingeschaltet ist
+     * ({@link NeoSettings#showDraftRanking}), sonst {@code null}. Genau das,
+     * was {@code CardNode.setDraftRank} erwartet.
+     */
+    public static Integer shown(final PaperCard card) {
+        return NeoSettings.showDraftRanking() && card != null ? of(card) : null;
+    }
+
+    /**
+     * Wie {@link #shown}, aber ohne Grundlaender: beim Deckbau stehen sie
+     * unbegrenzt bereit, und eine 0 auf jeder Insel waere nur Rauschen.
+     */
+    public static Integer shownForDeck(final PaperCard card) {
+        return DraftDeckContext.isBasic(card) ? null : shown(card);
+    }
+}
