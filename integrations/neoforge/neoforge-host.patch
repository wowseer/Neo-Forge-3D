+    /**
+     * Neo Forge 3D: Spielfeld des 3D-Tisches nach dem Ort des Kampfs:
+     * <ul>
+     * <li>Arena-Turnier oder Event (Draft, Turnier): {@code arena};</li>
+     * <li>in einer Stadt: {@code taverne}; in Burg, Hauptstadt oder bei einem Boss-Ort: {@code burg};</li>
+     * <li>sonst (Weltkarte, Hoehle, Verlies) nach dem Gelaende: weiss {@code ebene}, gruen
+     * {@code wald}, blau und Meer {@code inseln}, schwarz {@code sumpf}, rot {@code gebirge},
+     * Oedland und Wuesten {@code oedland}.</li>
+     * </ul>
+     * Ist nichts zu erkennen, gilt die Einstellung ({@code null}).
+     */
+    static String adventureBoard() {
+        try {
+            // Szene vor dem Duell (Forge.lastScene: die zuletzt verlassene steht hinten)
+            final java.lang.reflect.Field f = forge.Forge.class.getDeclaredField("lastScene");
+            f.setAccessible(true);
+            final com.badlogic.gdx.utils.Array<?> last = (com.badlogic.gdx.utils.Array<?>) f.get(null);
+            final Object previous = last == null || last.size == 0 ? null : last.peek();
+            if (previous instanceof forge.adventure.scene.ArenaScene
+                    || previous instanceof forge.adventure.scene.EventScene) {
+                return "arena";
+            }
+            forge.adventure.data.BiomeData biome = null;
+            if (forge.adventure.stage.MapStage.getInstance().isInMap()) {
+                final forge.adventure.pointofintrest.PointOfInterest poi =
+                        forge.adventure.scene.TileMapScene.instance().rootPoint;
+                if (poi != null) {
+                    final String type = poi.getData() == null || poi.getData().type == null ? ""
+                            : poi.getData().type.toLowerCase(java.util.Locale.ROOT);
+                    if (type.equals("town")) {
+                        return "taverne";
+                    }
+                    if (type.equals("castle") || type.equals("capital") || type.startsWith("sideboss")) {
+                        return "burg";
+                    }
+                    biome = forge.adventure.scene.GameScene.instance().getBiomeDataByPosition(poi.getPosition());
+                }
+            } else {
+                // Weltkarte: Gelaende an der Stelle des Spielers
+                final java.lang.reflect.Method m =
+                        forge.adventure.stage.WorldStage.class.getDeclaredMethod("getBiome");
+                m.setAccessible(true);
+                biome = (forge.adventure.data.BiomeData) m.invoke(forge.adventure.stage.WorldStage.getInstance());
+            }
+            final String name = biome == null || biome.name == null ? "" : biome.name.toLowerCase(java.util.Locale.ROOT);
+            switch (name) {
+                case "white": return "ebene";
+                case "green": return "wald";
+                case "blue": case "ocean": case "luxa": return "inseln";
+                case "black": case "ifnir": return "sumpf";
+                case "red": return "gebirge";
+                case "waste": case "outlands": case "naktamun": case "ramunap": case "shefet": return "oedland";
+                default: return null;
+            }
+        } catch (final Exception | LinkageError e) {
+            log("3D-Tisch: Gelaende nicht erkannt: " + e);
+            return null;
+        }
+    }
