diff --git a/forge-gui-neo/src/main/resources/forge/neo/neo.css b/forge-gui-neo/src/main/resources/forge/neo/neo.css
index a7e9f17..05d3c75 100644
--- a/forge-gui-neo/src/main/resources/forge/neo/neo.css
