+    /**
+     * Neo Forge 3D: baja la vida de {@code seat} como {@link #replace} (nada si
+     * no esta marcada o el duelo fija la vida). Para el 3D-Tisch, donde el
+     * asiento del jugador ya no llega al motor con interfaz.
+     */
+    public static void lower(final RegisteredPlayer seat, final QuestEvent event) {
+        final int drop = drop();
+        if (seat == null || drop <= 0 || fixedLife(event)) {
