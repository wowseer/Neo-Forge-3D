+    /**
+     * Neo Forge 3D: das Match eines Quest-Duells am 3D-Tisch. Forge ({@code QuestUtil}) baut die
+     * Sitze selbst und gibt den des Spielers mit seiner Oberflaeche herein; hier rueckt er auf
+     * Sitzplatz 0 und bekommt den ferngesteuerten Spieler des Tisches (gleicher Name). Die Partie
+     * startet dann ohne menschliche Oberflaeche -- NeoMatchUI schaut als Zuschauer zu (Fabrik in
+     * {@link NeoGuiBase}). Die Vida baja ({@link QuestLowLife}) gilt auch hier.
+     */
+    private static final class Table3dMatch extends forge.gamemodes.match.HostedMatch {
+        private final QuestEvent duel;
+        private forge.game.player.RegisteredPlayer seat;
+        private forge.LobbyPlayer questPlayer;
+
+        Table3dMatch(final QuestEvent duel) {
+            this.duel = duel;
+        }
+
+        @Override
+        public void startMatch(final forge.game.GameRules rules, final java.util.Set<forge.game.GameType> variants,
+                               final java.util.List<forge.game.player.RegisteredPlayer> players,
+                               final java.util.Map<forge.game.player.RegisteredPlayer, forge.gui.interfaces.IGuiGame> guis,
+                               final forge.sound.MusicPlaylist playlist) {
+            final forge.game.player.RegisteredPlayer me = guis == null || guis.size() != 1
+                    ? null : guis.keySet().iterator().next();
+            if (me == null || !players.contains(me) || players.size() != 2) {
+                // Kommt bei der Quest nicht vor; dann ohne Tisch weiter wie Forge es will.
+                super.startMatch(rules, variants, players, guis, playlist);
+                return;
+            }
+            QuestLowLife.lower(me, duel);
+            final java.util.List<forge.game.player.RegisteredPlayer> seats = new java.util.ArrayList<>(players);
+            seats.remove(me);
+            seats.add(0, me);
+            seat = me;
+            questPlayer = me.getPlayer();
+            me.setPlayer(forge.neo.clash.ClashTable.player(questPlayer.getName(), 0));
+            forge.neo.clash.ClashTable.sendLook(seats);
+            super.startMatch(rules, variants, seats, null, playlist);
+        }
+
+        /** Den Sitz wieder Forges Quest-Spieler geben (fuer Sieg, Belohnungen, Statistik). */
+        void restoreQuestPlayer() {
+            if (seat != null && questPlayer != null) {
+                seat.setPlayer(questPlayer);
+            }
+        }
+    }
